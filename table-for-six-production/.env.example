# Public (safe in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SHOPIFY_SHOP_DOMAIN=queermcr.co.uk

# Server only (never use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=customer_account_public_client_id
SHOPIFY_CUSTOMER_ACCOUNT_ISSUER=https://shopify.com/YOUR_SHOP_ID/account
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=https://shopify.com/YOUR_SHOP_ID/account/customer/api/2026-10/graphql
SHOPIFY_WEBHOOK_SECRET=webhook_signing_secret
SHOPIFY_ADMIN_ACCESS_TOKEN=admin_api_token_with_required_scope
SHOPIFY_ADMIN_API_SHOP=YOUR-STORE.myshopify.com
SHOPIFY_API_VERSION=2026-10
